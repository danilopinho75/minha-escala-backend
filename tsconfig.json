{
  "compilerOptions": {
    // Compilação
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "rootDir": "./src",

    // Interop
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    // Checagem de tipos
    "strict": true,

    // Outros
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/generated", "prisma/seed.ts"]
}
